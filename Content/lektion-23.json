 "grammar": [
  {
   "title": "Konjunktiv Perfekt und Plusquamperfekt",
   "blocks": [
    {
     "type": "text",
     "text": "Im Gegensatz zum Konjunktiv Präsens und Imperfekt werden diese beiden Konjunktive vom Perfektstamm gebildet. Dementsprechend ist das Passiv, wie jede Form des passiven Perfektstammes, zweiteilig."
    },
    {
     "type": "text",
     "text": "a) Konjunktiv Perfekt:"
    },
    {
     "type": "list",
     "items": [
      "Aktiv: aktiver Perfektstamm + -erim, -eris, -erit (Sg.) bzw. -erimus, -eritis, -erint (Pl.)",
      "Passiv: PPP + sim, sis, sit (Sg.) bzw. simus, sitis, sint (Pl.)"
     ]
    },
    {
     "type": "table",
     "headers": [
      "",
      "a-Konj. Aktiv",
      "a-Konj. Passiv",
      "e-Konj. Aktiv",
      "e-Konj. Passiv"
     ],
     "rows": [
      [
       "Sg. 1.P.",
       "amaverim",
       "amatus/a sim",
       "monuerim",
       "monitus/a sim"
      ],
      [
